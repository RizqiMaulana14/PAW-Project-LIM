<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-[#f8f9fa] text-slate-800 font-sans antialiased selection:bg-slate-900 selection:text-white min-h-screen">

  <div class="flex flex-col md:flex-row min-h-screen">
    <!-- Sidebar Navigasi -->
    <%- include('partials/sidebar') %>

    <!-- Konten Utama: 3 · Log Peminjaman -->
    <main class="flex-grow p-6 sm:p-10 lg:p-12 max-w-7xl mx-auto w-full space-y-8">
      
      <!-- Header & Counter Card -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="space-y-1">
          <span class="text-[11px] font-bold tracking-widest text-slate-400 uppercase">
            Aktivitasmu
          </span>
          <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight font-heading">
            Log Peminjaman
          </h1>
          <p class="text-sm text-slate-500">
            Pantau status dan kelola semua buku yang sedang kamu pinjam.
          </p>
        </div>

        <!-- Box Penghitung Buku Aktif (Sesuai Wireframe) -->
        <div class="bg-white border border-slate-200 rounded-2xl px-6 py-4 shadow-sm text-right shrink-0 min-w-[120px]">
          <div class="text-3xl font-extrabold text-slate-900 font-heading leading-tight" id="activeLoanCounter">
            <%= activeLoans.length %>
          </div>
          <span class="text-xs text-slate-400 font-medium">buku aktif</span>
        </div>
      </div>

      <!-- Tab Navigasi: Sedang Dipinjam & Riwayat -->
      <div class="flex items-center space-x-6 border-b border-slate-200 text-sm font-semibold">
        <button 
          onclick="switchLogTab('aktif')" 
          id="tabBtnAktif" 
          class="pb-3 border-b-2 border-slate-900 text-slate-900 transition-colors"
        >
          Sedang dipinjam (<span id="tabCountAktif"><%= activeLoans.length %></span>)
        </button>
        <button 
          onclick="switchLogTab('riwayat')" 
          id="tabBtnRiwayat" 
          class="pb-3 border-b-2 border-transparent text-slate-400 hover:text-slate-700 transition-colors"
        >
          Riwayat (<span id="tabCountRiwayat"><%= loanHistory.length %></span>)
        </button>
      </div>

      <!-- TAB 1: Sedang Dipinjam Section -->
      <div id="tabContentAktif" class="space-y-4">
        <div class="flex items-center justify-between text-xs">
          <h3 class="font-bold text-slate-900">Sedang dipinjam</h3>
          <span class="text-slate-400 flex items-center space-x-1.5 text-[11px]">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Diperbarui secara real-time</span>
          </span>
        </div>

        <div class="bg-white border border-slate-200/90 rounded-2xl p-5 shadow-sm space-y-4" id="activeLoansContainer">
          <% if (activeLoans && activeLoans.length > 0) { %>
            <% activeLoans.forEach(loan => { %>
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 py-4 border-b border-slate-100 last:border-0 loan-item" id="item-<%= loan.id %>">
                
                <!-- Info Buku & Cover -->
                <div class="flex items-center space-x-4">
                  <div class="w-14 h-16 rounded-xl <%= loan.coverBg || 'bg-slate-200' %> flex items-center justify-center text-slate-400 text-xs font-mono shrink-0">
                    Cover
                  </div>

                  <div class="space-y-1">
                    <div>
                      <% if (loan.isOverdue || loan.status === 'Jatuh tempo') { %>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200 inline-block mb-1">
                          Jatuh tempo
                        </span>
                      <% } else { %>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600 border border-slate-200 inline-block mb-1">
                          Sedang dipinjam
                        </span>
                      <% } %>
                      <h4 class="text-sm font-bold text-slate-900 leading-snug"><%= loan.title %></h4>
                    </div>
                    <p class="text-xs text-slate-400"><%= loan.author %></p>
                  </div>
                </div>

                <!-- Periode & Sisa Waktu & Tombol Batalkan -->
                <div class="flex flex-wrap items-center gap-4 sm:gap-8 text-xs text-slate-500 pl-18 sm:pl-0">
                  <div class="space-y-0.5">
                    <span class="text-[10px] text-slate-400 block font-medium">Periode peminjaman</span>
                    <span class="font-semibold text-slate-800"><%= loan.startDate %> – <%= loan.endDate %></span>
                  </div>

                  <div class="space-y-0.5">
                    <span class="text-[10px] text-slate-400 block font-medium">Sisa waktu</span>
                    <% if (loan.isOverdue || loan.status === 'Jatuh tempo') { %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">
                        <%= loan.remainingDays %>
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700">
                        <%= loan.remainingDays %>
                      </span>
                    <% } %>
                  </div>

                  <!-- Tombol Batalkan (Membuka dialog konfirmasi) -->
                  <div>
                    <button 
                      onclick="confirmCancelLoan('<%= loan.id %>', '<%= loan.title %>')" 
                      class="px-3.5 py-1.5 rounded-xl border border-dashed border-slate-300 hover:border-rose-400 hover:bg-rose-50 text-slate-600 hover:text-rose-600 text-xs font-semibold transition-colors flex items-center space-x-1.5"
                    >
                      <i class="fa-regular fa-trash-can text-xs"></i>
                      <span>Batalkan</span>
                    </button>
                  </div>
                </div>

              </div>
            <% }); %>
          <% } else { %>
            <!-- State Kosong Sesuai Wireframe -->
            <div class="py-12 text-center space-y-3" id="emptyLoansState">
              <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto text-xl">
                <i class="fa-solid fa-book-open-reader"></i>
              </div>
              <h4 class="text-sm font-bold text-slate-700">Belum ada buku yang dipinjam</h4>
              <p class="text-xs text-slate-400 max-w-xs mx-auto">
                Jelajahi koleksi buku dan lakukan reservasi tanpa antre.
              </p>
              <a href="/katalog" class="inline-block px-4 py-2 bg-slate-900 text-white text-xs font-semibold rounded-xl">
                Buka katalog
              </a>
            </div>
          <% } %>
        </div>
      </div>

      <!-- TAB 2: Riwayat Terakhir Section -->
      <div id="tabContentRiwayat" class="space-y-4 hidden">
        <h3 class="font-bold text-slate-900 text-xs">Riwayat terakhir</h3>

        <div class="bg-white border border-slate-200/90 rounded-2xl p-5 shadow-sm space-y-4" id="historyLoansContainer">
          <% if (loanHistory && loanHistory.length > 0) { %>
            <% loanHistory.forEach(hist => { %>
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 py-4 border-b border-slate-100 last:border-0">
                <div class="flex items-center space-x-4">
                  <div class="w-14 h-16 rounded-xl <%= hist.coverBg || 'bg-slate-200' %> flex items-center justify-center text-slate-400 text-xs font-mono shrink-0">
                    Cover
                  </div>

                  <div class="space-y-1">
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600 border border-slate-200 inline-block">
                      <%= hist.status %>
                    </span>
                    <h4 class="text-sm font-bold text-slate-900 leading-snug"><%= hist.title %></h4>
                    <p class="text-xs text-slate-400"><%= hist.author %></p>
                  </div>
                </div>

                <div class="text-xs text-slate-500 text-right">
                  <span class="font-semibold text-slate-800 block"><%= hist.startDate %> – <%= hist.endDate %></span>
                  <span class="text-slate-400 text-[11px]"><%= hist.note || 'Selesai' %></span>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div class="py-12 text-center text-xs text-slate-400">
              Belum ada riwayat peminjaman sebelumnya.
            </div>
          <% } %>
        </div>
      </div>

    </main>
  </div>

  <!-- Dialog Konfirmasi Pembatalan Peminjaman (Sesuai Catatan Catatan Mockup) -->
  <div id="cancelConfirmModal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-3xl max-w-sm w-full p-6 space-y-4 shadow-2xl text-center">
      <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mx-auto text-xl">
        <i class="fa-regular fa-trash-can"></i>
      </div>

      <div class="space-y-1">
        <h4 class="text-base font-bold text-slate-900">Batalkan Peminjaman?</h4>
        <p class="text-xs text-slate-500 leading-relaxed">
          Peminjaman buku <strong id="cancelBookTitle" class="text-slate-800"></strong> akan dihapus dan status buku akan kembali tersedia di katalog.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-2 pt-2">
        <button 
          onclick="closeCancelModal()" 
          class="py-2.5 px-4 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-semibold transition-colors"
        >
          Kembali
        </button>
        <button 
          id="btnConfirmCancel" 
          class="py-2.5 px-4 rounded-xl bg-rose-600 hover:bg-rose-500 text-white text-xs font-semibold shadow-sm transition-all"
        >
          Ya, batalkan
        </button>
      </div>
    </div>
  </div>

  <!-- Modal REST API Console Week 7 -->
  <%- include('partials/apiModal') %>

  <!-- Scripts -->
  <script src="/index.js"></script>
</body>
</html>
