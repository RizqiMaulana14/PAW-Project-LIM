<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-[#f8f9fa] text-slate-800 font-sans antialiased selection:bg-slate-900 selection:text-white min-h-screen w-full overflow-x-hidden">

  <div class="flex flex-col md:flex-row min-h-screen w-full max-w-full overflow-x-hidden">
    <!-- Sidebar Navigasi -->
    <%- include('partials/sidebar') %>

    <!-- Konten Utama: 1 · Katalog Buku -->
    <main class="flex-1 min-w-0 p-6 sm:p-10 lg:p-12 max-w-7xl mx-auto space-y-8">
      
      <!-- Header Halaman & Tombol Tambah Produk (CREATE) -->
      <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="space-y-1">
          <div class="flex items-center space-x-2">
            <span class="text-[11px] font-bold tracking-widest text-slate-400 uppercase">
              Koleksi Perpustakaan Kampus
            </span>
            <span class="px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 text-[10px] font-bold border border-emerald-200">
              <i class="fa-solid fa-database mr-1"></i>PostgreSQL Connected
            </span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight font-heading">
            Temukan buku. Mulai petualangan.
          </h1>
          <p class="text-sm text-slate-500">
            Jelajahi koleksi buku perpustakaan dan lakukan peminjaman secara mandiri.
          </p>
        </div>
      </header>

      <!-- Search Bar dengan Penghitung Hasil Real-time -->
      <section>
        <form action="/katalog" method="GET" class="relative max-w-2xl">
          <input 
            type="text" 
            id="searchInput" 
            name="search" 
            value="<%= typeof query !== 'undefined' ? query : '' %>"
            placeholder="Cari judul, penulis, kode, atau kategori..." 
            class="w-full pl-5 pr-28 py-3.5 bg-white border border-slate-200/90 rounded-2xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent shadow-sm transition-all"
          >
          <div class="absolute right-3 top-2.5 bottom-2.5 flex items-center">
            <span class="px-2.5 py-1 rounded-xl bg-slate-100 text-slate-500 text-xs font-semibold" id="bookCountPill">
              <%= books.length %> buku
            </span>
          </div>
        </form>
      </section>

      <!-- Filter Cepat (Semua / Tersedia / Dipinjam / Kategori) -->
      <section class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none">
        <% categories.forEach(category => { %>
          <a 
            href="/katalog?kategori=<%= encodeURIComponent(category === 'Semua' ? '' : category) %><%= query ? '&search=' + encodeURIComponent(query) : '' %>"
            class="px-4 py-2 rounded-full text-xs font-medium whitespace-nowrap transition-all border <%= selectedCategory === category ? 'bg-slate-900 text-white border-slate-900 shadow-sm' : 'bg-white text-slate-600 border-slate-200 hover:border-slate-300 hover:text-slate-900' %>"
          >
            <%= category %>
          </a>
        <% }); %>
      </section>

      <!-- Section: Pilihan Untukmu & Manajemen Koleksi -->
      <section class="space-y-4">
        <div class="flex items-end justify-between border-b border-slate-200/60 pb-3">
          <div>
            <span class="text-[10px] font-bold tracking-widest text-slate-400 uppercase">Pilihan Untukmu</span>
            <h2 class="text-xl font-bold text-slate-900 font-heading">Koleksi Pustaka Aktif</h2>
          </div>
          <div class="flex items-center space-x-2 text-xs text-slate-500">
            <span>Total: <strong class="text-slate-800" id="totalBooksHeader"><%= stats.total %></strong> judul</span>
            <span>•</span>
            <span class="text-emerald-600"><%= stats.available %> Tersedia</span>
            <span>•</span>
            <span class="text-slate-400"><%= stats.borrowed %> Dipinjam</span>
          </div>
        </div>

        <!-- Grid Kartu Buku (Operasi READ) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5" id="bookGrid">
          <% if (books && books.length > 0) { %>
            <% books.forEach(book => { %>
              <div class="bg-white border border-slate-200/90 hover:border-slate-300 rounded-2xl p-4 shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between group book-card" id="card-<%= book.id %>" data-id="<%= book.id %>">
                
                <!-- Cover Buku Box -->
                <div class="h-44 rounded-xl <%= book.coverBg || 'bg-slate-100' %> p-3.5 flex flex-col justify-between relative overflow-hidden mb-3 border border-slate-100">
                  <div class="flex items-start justify-between relative z-10">
                    <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-white/70 backdrop-blur-sm text-slate-700">
                      <%= book.kategori || book.category %>
                    </span>

                    <!-- Status Tersedia / Dipinjam -->
                    <% if (book.status === 'Tersedia') { %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-sm">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></span>
                        Tersedia
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-500 border border-slate-200 shadow-sm">
                        <span class="w-1.5 h-1.5 rounded-full bg-slate-400 mr-1.5"></span>
                        Dipinjam
                      </span>
                    <% } %>
                  </div>

                  <!-- Cover Center Text -->
                  <div class="text-center my-auto py-1">
                    <span class="text-xs text-slate-400 font-mono tracking-widest uppercase">Cover Buku</span>
                  </div>

                  <div class="flex items-center justify-between text-[10px] text-slate-500 font-mono">
                    <span><%= book.lokasiRak || book.lokasi_rak || 'Rak Umum' %></span>
                    <span><%= book.kode %></span>
                  </div>
                </div>

                <!-- Judul & Penulis -->
                <div class="space-y-1 mb-3">
                  <div class="flex items-center justify-between text-[11px] text-slate-400">
                    <span>Tahun: <strong class="text-slate-700"><%= book.tahun || 2024 %></strong></span>
                    <span>Rak: <strong class="text-slate-700"><%= book.lokasi_rak || book.lokasiRak || 'Rak Umum' %></strong></span>
                  </div>
                  <h3 class="text-sm font-bold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-1 leading-snug cursor-pointer" onclick="openDetailModal('<%= book.id %>')" title="<%= book.nama || book.title %>">
                    <%= book.nama || book.title %>
                  </h3>
                  <p class="text-xs text-slate-400 truncate">
                    <%= book.penulis || book.author %>
                  </p>
                </div>

                <!-- Tombol Aksi: Jadwal & Pinjam -->
                <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-100">
                  <a 
                    href="/jadwal/<%= book.id %>" 
                    class="py-2 px-3 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-semibold text-center transition-colors"
                  >
                    Jadwal
                  </a>

                  <% if (book.status === 'Tersedia') { %>
                    <a 
                      href="/jadwal/<%= book.id %>?action=pinjam" 
                      class="py-2 px-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold text-center shadow-sm transition-all"
                    >
                      Pinjam
                    </a>
                  <% } else { %>
                    <button 
                      disabled 
                      class="py-2 px-3 rounded-xl bg-slate-100 text-slate-400 text-xs font-semibold text-center cursor-not-allowed border border-slate-200"
                    >
                      Pinjam
                    </button>
                  <% } %>
                </div>

              </div>
            <% }); %>
          <% } else { %>
            <div class="col-span-full py-16 text-center bg-white border border-dashed border-slate-200 rounded-3xl">
              <p class="text-sm text-slate-500 mb-3">Tidak ada buku yang cocok dengan pencarian.</p>
              <a href="/katalog" class="px-4 py-2 bg-slate-900 text-white text-xs font-semibold rounded-xl">
                Reset Filter
              </a>
            </div>
          <% } %>
        </div>
      </section>

    </main>
  </div>

  <!-- Modal Detail Buku -->
  <div id="modalDetailProduct" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-3xl max-w-lg w-full p-6 space-y-4 shadow-2xl relative">
      <button onclick="closeDetailModal()" class="absolute top-5 right-5 text-slate-400 hover:text-slate-700 text-lg p-1">
        <i class="fa-solid fa-xmark"></i>
      </button>

      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-slate-700 font-bold">
          <i class="fa-solid fa-book text-base"></i>
        </div>
        <div>
          <span id="detailKode" class="text-[11px] font-mono text-slate-400 block font-semibold">BOK-001</span>
          <h3 id="detailTitle" class="text-base font-bold text-slate-900 font-heading leading-tight">Judul Buku</h3>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-2 bg-slate-50 p-3.5 rounded-2xl border border-slate-100 text-xs text-slate-600">
        <div>
          <span class="text-[10px] text-slate-400 block">Penulis</span>
          <strong id="detailAuthor" class="text-slate-800">-</strong>
        </div>
        <div>
          <span class="text-[10px] text-slate-400 block">Kategori</span>
          <strong id="detailCategory" class="text-slate-800">-</strong>
        </div>
        <div>
          <span class="text-[10px] text-slate-400 block">Status Ketersediaan</span>
          <strong id="detailStatusText" class="text-slate-800">-</strong>
        </div>
        <div>
          <span class="text-[10px] text-slate-400 block">Lokasi Rak</span>
          <strong id="detailRak" class="text-slate-800">-</strong>
        </div>
      </div>

      <div>
        <h5 class="text-xs font-bold text-slate-700 mb-1">Sinopsis</h5>
        <p id="detailDesc" class="text-xs text-slate-500 leading-relaxed bg-slate-50/70 p-3 rounded-xl border border-slate-100 line-clamp-4">
          -
        </p>
      </div>

      <div class="flex items-center justify-end space-x-2 pt-2 border-t border-slate-100">
        <button onclick="closeDetailModal()" class="px-4 py-2 rounded-xl border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-slate-50">
          Tutup
        </button>
        <a id="detailJadwalLink" href="#" class="px-4 py-2 rounded-xl bg-slate-900 text-white text-xs font-semibold hover:bg-slate-800">
          Lihat Jadwal Pinjam
        </a>
      </div>
    </div>
  </div>

  <!-- Floating Toast Notification -->
  <div id="toastNotification" class="fixed top-5 right-5 z-50 bg-slate-900 text-white px-5 py-3 rounded-2xl shadow-2xl flex items-center space-x-3 text-xs hidden transition-all">
    <i class="fa-solid fa-circle-check text-emerald-400 text-base" id="toastIcon"></i>
    <div>
      <h5 class="font-bold" id="toastTitle">Operasi Berhasil</h5>
      <p class="text-slate-300 text-[11px]" id="toastDesc">Data telah disimpan di database PostgreSQL.</p>
    </div>
  </div>

  <!-- Client-side Interactive Script -->
  <script src="/index.js"></script>
</body>
</html>
