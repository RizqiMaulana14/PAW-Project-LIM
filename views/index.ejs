<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-[#f8f9fa] text-slate-800 font-sans antialiased selection:bg-slate-900 selection:text-white min-h-screen">

  <div class="flex flex-col md:flex-row min-h-screen">

    <%- include('partials/navbar') %>

    <!-- Konten Utama -->
    <main class="flex-grow p-6 sm:p-10 lg:p-12 max-w-7xl mx-auto w-full space-y-8">

      <!-- Header Halaman -->
      <header class="space-y-2">
        <span class="text-[11px] font-bold tracking-widest text-slate-400 uppercase">
          Koleksi Perpustakaan Kampus
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight font-heading">
          Temukan buku. Mulai petualangan.
        </h1>
        <p class="text-sm text-slate-500">
          Cari koleksi, cek jadwal real-time, dan pinjam tanpa perlu antre.
        </p>
      </header>

      <!-- Search Bar -->
      <section>
        <form action="/" method="GET" class="search-box relative max-w-2xl">
          <input
            type="text"
            id="searchInput"
            name="search"
            value="<%= typeof query !== 'undefined' ? query : '' %>"
            placeholder="Cari judul, penulis, atau kategori..."
            class="w-full pl-5 pr-28 py-3.5 bg-white border border-slate-200/90 rounded-2xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent shadow-sm transition-all"
          >
          <div class="absolute right-3 top-2.5 bottom-2.5 flex items-center">
            <span class="px-2.5 py-1 rounded-xl bg-slate-100 text-slate-500 text-xs font-semibold" id="bookCountPill">
              <%= typeof books !== 'undefined' ? books.length : 0 %> buku
            </span>
          </div>
        </form>
      </section>

      <!-- Filter Cepat (tampilan saja, tidak berfungsi) -->
      <section class="flex items-center gap-2 overflow-x-auto pb-1">
        <span class="px-4 py-2 rounded-full text-xs font-medium whitespace-nowrap border bg-slate-900 text-white border-slate-900 shadow-sm cursor-default">Semua</span>
        <span class="px-4 py-2 rounded-full text-xs font-medium whitespace-nowrap border bg-white text-slate-600 border-slate-200 cursor-default">Tersedia</span>
        <span class="px-4 py-2 rounded-full text-xs font-medium whitespace-nowrap border bg-white text-slate-600 border-slate-200 cursor-default">Dipinjam</span>
        <span class="px-4 py-2 rounded-full text-xs font-medium whitespace-nowrap border bg-white text-slate-600 border-slate-200 cursor-default">Fiksi</span>
        <span class="px-4 py-2 rounded-full text-xs font-medium whitespace-nowrap border bg-white text-slate-600 border-slate-200 cursor-default">Pengembangan Diri</span>
        <span class="px-4 py-2 rounded-full text-xs font-medium whitespace-nowrap border bg-white text-slate-600 border-slate-200 cursor-default">Sejarah</span>
        <span class="px-4 py-2 rounded-full text-xs font-medium whitespace-nowrap border bg-white text-slate-600 border-slate-200 cursor-default">Teknologi Informasi</span>
        <span class="px-4 py-2 rounded-full text-xs font-medium whitespace-nowrap border bg-white text-slate-600 border-slate-200 cursor-default">Kecerdasan Buatan</span>
        <span class="px-4 py-2 rounded-full text-xs font-medium whitespace-nowrap border bg-white text-slate-600 border-slate-200 cursor-default">Ilmu Komunikasi</span>
      </section>

      <!-- Section: Koleksi Buku -->
      <section class="space-y-4">
        <div class="flex items-end justify-between border-b border-slate-200/60 pb-3">
          <div>
            <span class="text-[10px] font-bold tracking-widest text-slate-400 uppercase">Pilihan Untukmu</span>
            <h2 class="text-xl font-bold text-slate-900 font-heading">Buku populer minggu ini</h2>
          </div>
          <span class="text-xs font-semibold text-slate-500 flex items-center space-x-1 cursor-default">
            <span>Lihat semua</span>
            <i class="fa-solid fa-arrow-right text-[10px]"></i>
          </span>
        </div>

        <!-- Grid Kartu Buku -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5" id="bookGrid">
          <% if (typeof books !== 'undefined' && books && books.length > 0) { %>
            <% const coverColors = [
              'from-slate-200 to-slate-300 text-slate-700',
              'from-amber-100 to-amber-200 text-amber-900',
              'from-stone-200 to-stone-300 text-stone-800',
              'from-emerald-100 to-teal-200 text-emerald-900',
              'from-sky-100 to-blue-200 text-sky-900',
              'from-orange-100 to-amber-200 text-orange-900',
              'from-indigo-100 to-purple-200 text-indigo-900',
              'from-blue-100 to-indigo-200 text-blue-900',
              'from-violet-100 to-fuchsia-200 text-violet-900',
              'from-rose-100 to-pink-200 text-rose-900',
              'from-teal-100 to-cyan-200 text-teal-900',
            ]; %>
            <% books.forEach((book, index) => { %>
              <% const colorClass = coverColors[index % coverColors.length]; %>
              <div class="bg-white border border-slate-200/90 hover:border-slate-300 rounded-2xl p-4 shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between group">

                <!-- Cover Buku -->
                <div class="h-44 rounded-xl bg-gradient-to-br <%= colorClass %> p-3.5 flex flex-col justify-between relative overflow-hidden mb-4 border border-slate-100">
                  <div class="flex items-start justify-between relative z-10">
                    <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-white/70 backdrop-blur-sm text-slate-700">
                      <%= book.category %>
                    </span>
                    <% if (book.status === 'Tersedia') { %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-sm">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></span>
                        Tersedia
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-500 border border-slate-200 shadow-sm">
                        <span class="w-1.5 h-1.5 rounded-full bg-slate-400 mr-1.5"></span>
                        Dipinjam
                      </span>
                    <% } %>
                  </div>

                  <div class="text-center my-auto py-2">
                    <span class="text-xs text-slate-400 font-mono tracking-widest uppercase">Cover Buku</span>
                  </div>

                  <div class="text-[10px] text-slate-500 font-mono text-right">
                    <%= book.id %>
                  </div>
                </div>

                <!-- Judul & Penulis -->
                <div class="space-y-1 mb-5">
                  <h3 class="text-sm font-bold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-1 leading-snug" title="<%= book.title %>">
                    <%= book.title %>
                  </h3>
                  <p class="text-xs text-slate-400 truncate">
                    <%= book.author %>
                  </p>
                </div>

                <!-- Tombol Aksi (tampilan saja) -->
                <div class="grid grid-cols-2 gap-2 pt-1">
                  <span class="py-2 px-3 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-semibold text-center transition-colors cursor-default">
                    Jadwal
                  </span>
                  <% if (book.status === 'Tersedia') { %>
                    <span class="py-2 px-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold text-center shadow-sm transition-all cursor-default">
                      Pinjam
                    </span>
                  <% } else { %>
                    <span class="py-2 px-3 rounded-xl bg-slate-100 text-slate-400 text-xs font-semibold text-center cursor-not-allowed border border-slate-200">
                      Pinjam
                    </span>
                  <% } %>
                </div>

              </div>
            <% }); %>
          <% } else { %>
            <div class="col-span-full text-center py-16 px-5 bg-white border border-dashed border-slate-200 rounded-2xl text-slate-500 text-sm">
              <p>Buku tidak ditemukan.</p>
            </div>
          <% } %>
        </div>
      </section>

    </main>
  </div>

  <!-- Modal REST API Console -->
  <div id="apiTesterModal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-3xl max-w-2xl w-full p-6 space-y-5 shadow-2xl relative">

      <!-- Modal Header -->
      <div class="flex items-center justify-between border-b border-slate-100 pb-4">
        <div class="flex items-center space-x-3">
          <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 border border-blue-100 flex items-center justify-center font-bold text-sm">
            <i class="fa-solid fa-terminal"></i>
          </div>
          <div>
            <h3 class="text-base font-bold text-slate-900 font-heading">REST API Console &amp; Middleware Logger</h3>
            <p class="text-xs text-slate-400">Pengujian Endpoint — Pustaka LIM</p>
          </div>
        </div>
        <button onclick="closeApiTesterModal()" class="text-slate-400 hover:text-slate-700 text-lg p-1 transition-colors">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Endpoint Trigger Buttons -->
      <div class="flex flex-wrap items-center gap-2">
        <button onclick="testApiEndpoint('/api/status')" class="px-3.5 py-2 rounded-xl text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 transition-all flex items-center space-x-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>GET /api/status</span>
        </button>

        <button onclick="testApiEndpoint('/api/books')" class="px-3.5 py-2 rounded-xl text-xs font-semibold text-white bg-blue-600 hover:bg-blue-500 transition-all flex items-center space-x-1.5">
          <span class="w-2 h-2 rounded-full bg-blue-200"></span>
          <span>GET /api/books</span>
        </button>

        <a href="/api/status" target="_blank" class="px-3 py-2 rounded-xl text-xs text-slate-500 hover:text-slate-800 border border-slate-200 hover:bg-slate-50 transition-colors ml-auto" title="Buka di tab baru">
          <i class="fa-solid fa-arrow-up-right-from-square mr-1"></i> Tab Baru
        </a>
      </div>

      <!-- Output Box -->
      <div class="bg-slate-900 rounded-2xl p-4 text-xs font-mono text-slate-200 space-y-2">
        <div class="flex items-center justify-between text-[11px] text-slate-400 pb-2 border-b border-slate-800">
          <span id="apiModalStatus">Status: Siap</span>
          <span id="apiModalLatency">0 ms</span>
        </div>
        <pre id="apiModalJson" class="h-60 overflow-y-auto text-blue-300 leading-relaxed whitespace-pre-wrap break-all text-[11px]">Klik salah satu tombol endpoint di atas untuk menguji response API secara langsung.</pre>
      </div>

      <!-- Logger Notice -->
      <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 text-[11px] text-slate-600 flex items-start space-x-2">
        <i class="fa-solid fa-circle-info text-blue-500 mt-0.5"></i>
        <span>
          Setiap request di atas otomatis dicatat oleh <code class="font-mono bg-slate-100 px-1 rounded">middlewares/logger.js</code> di terminal console backend dengan HTTP method, endpoint, status code, dan timestamp!
        </span>
      </div>

    </div>
  </div>

  <script src="/index.js"></script>
</body>
</html>
