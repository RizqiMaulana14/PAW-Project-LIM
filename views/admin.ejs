<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-[#f8f9fa] text-slate-800 font-sans antialiased selection:bg-slate-900 selection:text-white min-h-screen">

  <div class="flex flex-col md:flex-row min-h-screen">
    <!-- Sidebar Navigasi -->
    <%- include('partials/sidebar') %>

    <!-- Konten Utama: Panel Pengelola / Admin -->
    <main class="flex-grow p-6 sm:p-10 lg:p-12 max-w-7xl mx-auto w-full space-y-8">
      
      <!-- Header Halaman Admin -->
      <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="space-y-1">
          <div class="flex items-center space-x-2">
            <span class="text-[11px] font-bold tracking-widest text-slate-400 uppercase">
              Administrasi Perpustakaan • Sistem Manajemen Pustaka
            </span>
            <span class="px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 text-[10px] font-bold border border-emerald-200">
              <i class="fa-solid fa-database mr-1"></i>MySQL Active
            </span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight font-heading">
            Panel Pengelola & Manajemen Produk
          </h1>
          <p class="text-sm text-slate-500">
            Kelola data buku dari database MySQL secara real-time melalui REST API CRUD dan pantau kesehatan server.
          </p>
        </div>

        <!-- Tombol Aksi Header -->
        <div class="flex items-center space-x-2.5 shrink-0">
          <button 
            onclick="fetchLiveSystemStatus()" 
            title="Perbarui Status Server (GET /api/status)"
            class="px-3.5 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-sm transition-all flex items-center space-x-1.5"
          >
            <i class="fa-solid fa-rotate text-xs text-slate-400" id="statusRefreshIcon"></i>
            <span>Cek Status Server</span>
          </button>

          <button 
            onclick="openAddModalAdmin()" 
            class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-md shadow-slate-900/10 transition-all flex items-center space-x-2"
          >
            <i class="fa-solid fa-plus text-xs text-amber-300"></i>
            <span>Tambah Produk Baru</span>
          </button>
        </div>
      </header>

      <!-- ==================================================================== -->
      <!-- 1. REST API MONITOR: GET /api/status                                  -->
      <!-- ==================================================================== -->
      <section class="space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <span class="text-[10px] font-bold tracking-widest text-slate-400 uppercase">REST API Monitor</span>
            <span class="text-xs font-mono px-2 py-0.5 rounded bg-blue-50 text-blue-700 font-bold border border-blue-200">
              GET /api/status
            </span>
          </div>
          <button 
            onclick="toggleRawStatusJson()" 
            class="text-[11px] text-slate-500 hover:text-slate-900 font-medium underline flex items-center space-x-1"
          >
            <i class="fa-solid fa-code text-[10px]"></i>
            <span id="btnToggleJsonLabel">Lihat Raw JSON Response</span>
          </button>
        </div>

        <!-- 4 Grid Kartu Status -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <!-- Card 1: Database Status -->
          <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-sm space-y-2">
            <div class="flex items-center justify-between text-xs text-slate-400">
              <span class="font-medium">Koneksi Database</span>
              <i class="fa-solid fa-server text-emerald-600"></i>
            </div>
            <div class="flex items-center space-x-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse" id="adminDbDot"></span>
              <span class="text-base font-extrabold text-slate-900 font-heading" id="adminDbStatusText">Connected</span>
            </div>
            <p class="text-[11px] text-slate-500 font-mono truncate" id="adminDbNameText">
              MySQL: <%= appConfig.db.name %>
            </p>
          </div>

          <!-- Card 2: Uptime Server -->
          <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-sm space-y-2">
            <div class="flex items-center justify-between text-xs text-slate-400">
              <span class="font-medium">Server Uptime</span>
              <i class="fa-regular fa-clock text-blue-600"></i>
            </div>
            <div class="text-base font-extrabold text-slate-900 font-heading" id="adminServerUptime">
              Memuat...
            </div>
            <p class="text-[11px] text-slate-500 font-mono truncate" id="adminServerPort">
              Port: <%= appConfig.port %> (Express.js)
            </p>
          </div>

          <!-- Card 3: Timestamp Server -->
          <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-sm space-y-2">
            <div class="flex items-center justify-between text-xs text-slate-400">
              <span class="font-medium">Timestamp Server</span>
              <i class="fa-regular fa-calendar-check text-purple-600"></i>
            </div>
            <div class="text-xs font-bold text-slate-900 font-mono truncate pt-1" id="adminTimestampText">
              Sinkronisasi...
            </div>
            <p class="text-[11px] text-slate-500 font-mono">
              Waktu Lokal Indonesia
            </p>
          </div>

          <!-- Card 4: Total Koleksi & Kategori -->
          <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-sm space-y-2">
            <div class="flex items-center justify-between text-xs text-slate-400">
              <span class="font-medium">Total Produk Aktif</span>
              <i class="fa-solid fa-boxes-stacked text-amber-600"></i>
            </div>
            <div class="text-base font-extrabold text-slate-900 font-heading">
              <span id="adminTotalBooksCount"><%= stats.total %></span> judul buku
            </div>
            <p class="text-[11px] text-slate-500">
              <span class="text-emerald-600 font-semibold" id="adminAvailCount"><%= stats.available %> Tersedia</span> • 
              <span class="text-slate-400" id="adminBorrowCount"><%= stats.borrowed %> Dipinjam</span>
            </p>
          </div>
        </div>

        <!-- Raw JSON Container (Hidden by default) -->
        <div id="rawStatusJsonContainer" class="hidden bg-slate-900 rounded-2xl p-4 border border-slate-800 text-xs font-mono text-emerald-400 space-y-2">
          <div class="flex items-center justify-between text-slate-400 text-[11px] pb-2 border-b border-slate-800">
            <span>GET /api/status — Response Body</span>
            <span id="rawStatusLatency">0 ms</span>
          </div>
          <pre id="rawStatusJsonContent" class="overflow-x-auto whitespace-pre-wrap text-[11px] text-blue-300 max-h-48"></pre>
        </div>
      </section>

      <!-- ==================================================================== -->
      <!-- 2. DATA UTAMA: GET /api/produk (TABEL PRODUK & CRUD)                  -->
      <!-- ==================================================================== -->
      <section class="space-y-4">
        
        <!-- Filter & Search Bar -->
        <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
          <div class="relative flex-grow max-w-md">
            <input 
              type="text" 
              id="adminSearchInput" 
              placeholder="Cari berdasarkan judul, penulis, kode, atau rak..." 
              class="w-full pl-10 pr-24 py-2.5 bg-white border border-slate-200 rounded-xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 shadow-sm transition-all"
            >
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3 text-slate-400 text-xs"></i>
            <span class="absolute right-2.5 top-2 px-2 py-0.5 rounded-lg bg-slate-100 text-slate-500 text-[10px] font-bold" id="adminTableCountPill">
              <%= books.length %> produk
            </span>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <!-- Filter Kategori -->
            <select 
              id="adminFilterCategory" 
              onchange="filterAdminTable()"
              class="px-3 py-2 bg-white border border-slate-200 rounded-xl text-xs text-slate-700 font-medium focus:outline-none focus:ring-1 focus:ring-slate-900 shadow-sm"
            >
              <% categories.forEach(cat => { %>
                <option value="<%= cat %>"><%= cat %></option>
              <% }); %>
            </select>

            <!-- Filter Status -->
            <select 
              id="adminFilterStatus" 
              onchange="filterAdminTable()"
              class="px-3 py-2 bg-white border border-slate-200 rounded-xl text-xs text-slate-700 font-medium focus:outline-none focus:ring-1 focus:ring-slate-900 shadow-sm"
            >
              <option value="Semua">Semua Status</option>
              <option value="Tersedia">Tersedia</option>
              <option value="Dipinjam">Dipinjam</option>
            </select>

            <!-- Direct Link ke Raw JSON Endpoint -->
            <a 
              href="/api/produk" 
              target="_blank" 
              title="Buka endpoint GET /api/produk di tab baru"
              class="px-3 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 text-xs font-medium transition-colors flex items-center space-x-1"
            >
              <i class="fa-solid fa-arrow-up-right-from-square text-[11px]"></i>
              <span>API JSON</span>
            </a>
          </div>
        </div>

        <!-- Tabel Koleksi Produk MySQL -->
        <div class="bg-white border border-slate-200/90 rounded-2xl shadow-sm overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-slate-700">
              <thead class="bg-slate-50/80 border-b border-slate-200/80 text-[11px] uppercase tracking-wider text-slate-400 font-bold">
                <tr>
                  <th class="px-5 py-3.5 w-44 min-w-[150px]">Kode Buku</th>
                  <th class="px-4 py-3.5">Judul Buku & Penulis</th>
                  <th class="px-4 py-3.5">Kategori</th>
                  <th class="px-4 py-3.5">Status Ketersediaan</th>
                  <th class="px-4 py-3.5">Lokasi Rak</th>
                  <th class="px-4 py-3.5 text-center">Tahun Terbit</th>
                  <th class="px-4 py-3.5 text-right">Aksi REST API</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100" id="adminTableBody">
                <% if (books && books.length > 0) { %>
                  <% books.forEach(book => { %>
                    <tr class="hover:bg-slate-50/70 transition-colors admin-row" id="row-<%= book.id %>" data-id="<%= book.id %>" data-title="<%= (book.nama || '').toLowerCase() %>" data-author="<%= (book.penulis || '').toLowerCase() %>" data-category="<%= book.kategori %>" data-status="<%= book.status %>" data-code="<%= (book.kode || '').toLowerCase() %>">
                      
                      <!-- Kode Buku -->
                      <td class="px-5 py-3.5 font-mono whitespace-nowrap w-44 min-w-[150px]">
                        <span class="inline-flex items-center px-3 py-1.5 rounded-xl bg-slate-100/90 text-slate-900 font-bold text-xs tracking-wider border border-slate-200/90 shadow-xs">
                          <i class="fa-solid fa-barcode text-[11px] text-slate-400 mr-2"></i>
                          <%= book.kode || 'BOK-' + book.id %>
                        </span>
                      </td>

                      <!-- Judul & Penulis -->
                      <td class="px-4 py-3.5 max-w-xs">
                        <div class="font-bold text-slate-900 truncate" title="<%= book.nama %>">
                          <%= book.nama %>
                        </div>
                        <div class="text-[11px] text-slate-400 truncate">
                          <%= book.penulis %> (<%= book.tahun || 2024 %>)
                        </div>
                      </td>

                      <!-- Kategori -->
                      <td class="px-4 py-3.5">
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-700 border border-slate-200">
                          <%= book.kategori || 'Umum' %>
                        </span>
                      </td>

                      <!-- Status -->
                      <td class="px-4 py-3.5">
                        <% if (book.status === 'Tersedia') { %>
                          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></span>
                            Tersedia
                          </span>
                        <% } else { %>
                          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-500 border border-slate-200">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400 mr-1.5"></span>
                            Dipinjam
                          </span>
                        <% } %>
                      </td>

                      <!-- Lokasi Rak -->
                      <td class="px-4 py-3.5 font-mono text-[11px] text-slate-500">
                        <%= book.lokasi_rak || book.lokasiRak || 'Rak Umum' %>
                      </td>

                      <!-- Tahun Terbit -->
                      <td class="px-4 py-3.5 text-center font-mono text-slate-700">
                        <%= book.tahun || 2024 %>
                      </td>

                      <!-- Aksi Tombol CRUD -->
                      <td class="px-4 py-3.5 text-right whitespace-nowrap">
                        <div class="inline-flex items-center space-x-1.5">
                          <!-- GET /api/produk/:id (Read One) -->
                          <button 
                            onclick="openDetailAdmin('<%= book.id %>')" 
                            title="GET /api/produk/<%= book.id %> (Lihat Detail & Raw JSON)"
                            class="p-1.5 rounded-lg text-slate-500 hover:text-blue-600 hover:bg-blue-50 border border-slate-200 transition-colors"
                          >
                            <i class="fa-regular fa-eye text-xs"></i>
                          </button>

                          <!-- PUT /api/produk/:id (Update) -->
                          <button 
                            onclick="openEditAdmin('<%= book.id %>')" 
                            title="PUT /api/produk/<%= book.id %> (Ubah Data Buku)"
                            class="p-1.5 rounded-lg text-slate-500 hover:text-amber-600 hover:bg-amber-50 border border-slate-200 transition-colors"
                          >
                            <i class="fa-regular fa-pen-to-square text-xs"></i>
                          </button>

                          <!-- DELETE /api/produk/:id (Delete) -->
                          <button 
                            data-title="<%= book.nama %>"
                            onclick="openDeleteAdmin('<%= book.id %>', this.getAttribute('data-title'))" 
                            title="DELETE /api/produk/<%= book.id %> (Hapus Produk)"
                            class="p-1.5 rounded-lg text-slate-500 hover:text-rose-600 hover:bg-rose-50 border border-slate-200 transition-colors"
                          >
                            <i class="fa-regular fa-trash-can text-xs"></i>
                          </button>
                        </div>
                      </td>

                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="8" class="text-center py-12 text-slate-400 text-xs">
                      Belum ada data produk di database MySQL.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Footer Tabel -->
          <div class="px-4 py-3 bg-slate-50/70 border-t border-slate-200/80 flex items-center justify-between text-[11px] text-slate-500">
            <span>Menampilkan data produk yang tersimpan pada tabel <code>produk</code> MySQL.</span>
            <span class="font-mono">Total: <strong id="adminTableFooterCount" class="text-slate-800"><%= books.length %></strong> item</span>
          </div>
        </div>

      </section>

    </main>
  </div>

  <!-- ======================================================================== -->
  <!-- MODAL 1: CREATE (POST /api/produk)                                       -->
  <!-- ======================================================================== -->
  <div id="modalAddAdmin" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-3xl max-w-lg w-full p-6 space-y-4 shadow-2xl relative">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <div class="flex items-center space-x-3">
          <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-sm">
            <i class="fa-solid fa-plus"></i>
          </div>
          <div>
            <h3 class="text-base font-bold text-slate-900 font-heading">Tambah Produk Buku Baru</h3>
            <p class="text-xs text-slate-400">Endpoint: <code class="text-emerald-600 font-bold">POST /api/produk</code></p>
          </div>
        </div>
        <button onclick="closeAddAdmin()" class="text-slate-400 hover:text-slate-700 text-lg p-1">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <form id="formAddAdmin" onsubmit="handleCreateAdmin(event)" class="space-y-3.5 text-xs">
        <div>
          <label class="font-semibold text-slate-700 block mb-1">Judul Buku / Nama Produk <span class="text-rose-500">*</span></label>
          <input 
            type="text" 
            name="nama" 
            required 
            placeholder="Contoh: Arsitektur Cloud Computing Modern" 
            class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:ring-1 focus:ring-slate-900 font-medium"
          >
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="font-semibold text-slate-700 block mb-1">Penulis / Author <span class="text-rose-500">*</span></label>
            <input 
              type="text" 
              name="penulis" 
              required 
              placeholder="Nama penulis" 
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:ring-1 focus:ring-slate-900 font-medium"
            >
          </div>

          <div>
            <label class="font-semibold text-slate-700 block mb-1">Kategori</label>
            <select 
              name="kategori_id" 
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:ring-1 focus:ring-slate-900"
            >
              <% if (typeof rawCategories !== 'undefined' && rawCategories.length > 0) { %>
                <% rawCategories.forEach(cat => { %>
                  <option value="<%= cat.id %>"><%= cat.nama %></option>
                <% }); %>
              <% } else { %>
                <option value="1">Umum</option>
              <% } %>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="font-semibold text-slate-700 block mb-1">Tahun Terbit</label>
            <input 
              type="number" 
              name="tahun" 
              value="2025" 
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:ring-1 focus:ring-slate-900 font-mono"
            >
          </div>

          <div>
            <label class="font-semibold text-slate-700 block mb-1">Lokasi Rak</label>
            <input 
              type="text" 
              name="lokasi_rak" 
              value="Rak TI-04" 
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:ring-1 focus:ring-slate-900 font-mono"
            >
          </div>
        </div>

        <div>
          <label class="font-semibold text-slate-700 block mb-1">Deskripsi Singkat</label>
          <textarea 
            name="deskripsi" 
            rows="2" 
            placeholder="Ringkasan atau sinopsis buku..." 
            class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:ring-1 focus:ring-slate-900 resize-none"
          ></textarea>
        </div>

        <div class="flex items-center justify-end space-x-2 pt-2 border-t border-slate-100">
          <button 
            type="button" 
            onclick="closeAddAdmin()" 
            class="px-4 py-2 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-600 font-semibold transition-colors"
          >
            Batal
          </button>
          <button 
            type="submit" 
            id="btnSubmitAddAdmin" 
            class="px-5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-semibold shadow-sm transition-all flex items-center space-x-1.5"
          >
            <i class="fa-solid fa-cloud-arrow-up"></i>
            <span>Simpan</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ======================================================================== -->
  <!-- MODAL 2: READ DETAIL & RAW JSON (GET /api/produk/:id)                    -->
  <!-- ======================================================================== -->
  <div id="modalDetailAdmin" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-3xl max-w-xl w-full p-6 space-y-4 shadow-2xl relative">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <div class="flex items-center space-x-3">
          <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-sm">
            <i class="fa-solid fa-circle-info"></i>
          </div>
          <div>
            <h3 class="text-base font-bold text-slate-900 font-heading">Detail Produk Buku</h3>
            <p class="text-xs text-slate-400">Endpoint: <code class="text-blue-600 font-bold" id="detailEndpointLabel">GET /api/produk/:id</code></p>
          </div>
        </div>
        <button onclick="closeDetailAdmin()" class="text-slate-400 hover:text-slate-700 text-lg p-1">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div class="space-y-3 text-xs" id="detailContentContainer">
        <!-- Info Ringkas -->
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 space-y-2">
          <div class="flex items-start justify-between">
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400" id="detailCategory">Kategori</span>
              <h4 class="text-base font-bold text-slate-900" id="detailTitle">Judul Buku</h4>
              <p class="text-slate-500" id="detailAuthor">Penulis</p>
            </div>
            <span class="px-2.5 py-1 rounded-full text-[11px] font-bold" id="detailStatusBadge">Tersedia</span>
          </div>
          <div class="grid grid-cols-3 gap-2 pt-2 border-t border-slate-200/80 text-[11px] font-mono">
            <div>Kode: <strong id="detailCode" class="text-slate-800">BOK-001</strong></div>
            <div>Rak: <strong id="detailShelf" class="text-slate-800">Rak TI-01</strong></div>
            <div>Tahun: <strong id="detailYear" class="text-slate-800">2024</strong></div>
          </div>
          <p class="text-slate-600 pt-1 leading-relaxed" id="detailDesc"></p>
        </div>

        <!-- Raw JSON Preview -->
        <div class="space-y-1">
          <div class="flex items-center justify-between text-slate-400 text-[11px]">
            <span>Raw JSON Response:</span>
            <span class="font-mono text-emerald-600 font-semibold">200 OK</span>
          </div>
          <pre id="detailJsonPre" class="bg-slate-900 text-blue-300 p-3.5 rounded-xl font-mono text-[11px] overflow-x-auto max-h-48 whitespace-pre-wrap"></pre>
        </div>
      </div>

      <div class="flex justify-end pt-2 border-t border-slate-100">
        <button 
          onclick="closeDetailAdmin()" 
          class="px-4 py-2 rounded-xl bg-slate-900 text-white font-semibold text-xs hover:bg-slate-800 transition-colors"
        >
          Tutup Detail
        </button>
      </div>
    </div>
  </div>

  <!-- ======================================================================== -->
  <!-- MODAL 3: UPDATE (PUT /api/produk/:id)                                    -->
  <!-- ======================================================================== -->
  <div id="modalEditAdmin" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-3xl max-w-lg w-full p-6 space-y-4 shadow-2xl relative">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <div class="flex items-center space-x-3">
          <div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-sm">
            <i class="fa-solid fa-pen-to-square"></i>
          </div>
          <div>
            <h3 class="text-base font-bold text-slate-900 font-heading">Ubah Data Produk</h3>
            <p class="text-xs text-slate-400">Endpoint: <code class="text-amber-600 font-bold" id="editEndpointLabel">PUT /api/produk/:id</code></p>
          </div>
        </div>
        <button onclick="closeEditAdmin()" class="text-slate-400 hover:text-slate-700 text-lg p-1">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <form id="formEditAdmin" onsubmit="handleUpdateAdmin(event)" class="space-y-3.5 text-xs">
        <input type="hidden" id="editAdminId" name="id">

        <div>
          <label class="font-semibold text-slate-700 block mb-1">Judul Buku / Nama Produk <span class="text-rose-500">*</span></label>
          <input 
            type="text" 
            id="editAdminNama" 
            name="nama" 
            required 
            class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:ring-1 focus:ring-slate-900 font-medium"
          >
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="font-semibold text-slate-700 block mb-1">Penulis / Author <span class="text-rose-500">*</span></label>
            <input 
              type="text" 
              id="editAdminPenulis" 
              name="penulis" 
              required 
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:ring-1 focus:ring-slate-900 font-medium"
            >
          </div>

          <div>
            <label class="font-semibold text-slate-700 block mb-1">Kategori</label>
            <select 
              id="editAdminKategoriId" 
              name="kategori_id" 
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:ring-1 focus:ring-slate-900"
            >
              <% if (typeof rawCategories !== 'undefined' && rawCategories.length > 0) { %>
                <% rawCategories.forEach(cat => { %>
                  <option value="<%= cat.id %>"><%= cat.nama %></option>
                <% }); %>
              <% } %>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="font-semibold text-slate-700 block mb-1">Status Ketersediaan</label>
            <select 
              id="editAdminStatus" 
              name="status" 
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:ring-1 focus:ring-slate-900 font-medium"
            >
              <option value="Tersedia">Tersedia</option>
              <option value="Dipinjam">Dipinjam</option>
            </select>
          </div>

          <div>
            <label class="font-semibold text-slate-700 block mb-1">Lokasi Rak</label>
            <input 
              type="text" 
              id="editAdminLokasiRak" 
              name="lokasi_rak" 
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:ring-1 focus:ring-slate-900 font-mono"
            >
          </div>
        </div>

        <div>
          <label class="font-semibold text-slate-700 block mb-1">Tahun Terbit</label>
          <input 
            type="number" 
            id="editAdminTahun" 
            name="tahun" 
            class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:ring-1 focus:ring-slate-900 font-mono"
          >
        </div>

        <div>
          <label class="font-semibold text-slate-700 block mb-1">Deskripsi Singkat</label>
          <textarea 
            id="editAdminDeskripsi" 
            name="deskripsi" 
            rows="2" 
            class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:ring-1 focus:ring-slate-900 resize-none"
          ></textarea>
        </div>

        <div class="flex items-center justify-end space-x-2 pt-2 border-t border-slate-100">
          <button 
            type="button" 
            onclick="closeEditAdmin()" 
            class="px-4 py-2 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-600 font-semibold transition-colors"
          >
            Batal
          </button>
          <button 
            type="submit" 
            id="btnSubmitEditAdmin" 
            class="px-5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-semibold shadow-sm transition-all flex items-center space-x-1.5"
          >
            <i class="fa-solid fa-check"></i>
            <span>Simpan Perubahan</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ======================================================================== -->
  <!-- MODAL 4: DELETE (DELETE /api/produk/:id)                                 -->
  <!-- ======================================================================== -->
  <div id="modalDeleteAdmin" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-3xl max-w-sm w-full p-6 space-y-4 shadow-2xl relative text-center">
      <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 border border-rose-100 flex items-center justify-center text-xl mx-auto">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </div>
      <div>
        <h3 class="text-base font-bold text-slate-900 font-heading">Hapus Produk dari Database?</h3>
        <p class="text-xs text-slate-400 mt-1">Endpoint: <code class="text-rose-600 font-bold" id="deleteEndpointLabel">DELETE /api/produk/:id</code></p>
      </div>
      <p class="text-xs text-slate-600 bg-slate-50 p-3 rounded-xl border border-slate-200">
        Buku <strong id="deleteAdminBookTitle" class="text-slate-900 block truncate mt-0.5"></strong> akan dihapus permanen dari MySQL.
      </p>
      <div class="flex items-center justify-center space-x-2 pt-2">
        <button 
          onclick="closeDeleteAdmin()" 
          class="px-4 py-2 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-600 text-xs font-semibold transition-colors"
        >
          Batal
        </button>
        <button 
          onclick="confirmDeleteAdmin()" 
          id="btnConfirmDeleteAdmin" 
          class="px-5 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold shadow-sm transition-all"
        >
          Ya, Hapus Sekarang
        </button>
      </div>
    </div>
  </div>

  <!-- Toast Notification Pop-up -->
  <div id="toastNotificationAdmin" class="fixed bottom-6 right-6 z-50 bg-slate-900 text-white px-5 py-3.5 rounded-2xl shadow-xl border border-slate-700/80 hidden flex items-center space-x-3 transition-all duration-300">
    <div class="w-8 h-8 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xs shrink-0">
      <i class="fa-solid fa-check"></i>
    </div>
    <div>
      <h5 class="text-xs font-bold text-white" id="toastTitleAdmin">Sukses</h5>
      <p class="text-[11px] text-slate-300" id="toastMessageAdmin">Operasi berhasil dijalankan.</p>
    </div>
  </div>

  <!-- Scripts Interaksi REST API Admin -->
  <script>
    let adminBooksData = [];
    let pendingDeleteAdminId = null;

    // 1. Inisialisasi: Ambil status server & produk dari backend
    document.addEventListener('DOMContentLoaded', () => {
      fetchLiveSystemStatus();
      loadAdminProductsData();
      setupAdminSearch();
    });

    // ========================================================================
    // GET /api/status - Live System & Database Status Monitor
    // ========================================================================
    async function fetchLiveSystemStatus() {
      const refreshIcon = document.getElementById('statusRefreshIcon');
      if (refreshIcon) refreshIcon.classList.add('fa-spin');
      const start = Date.now();

      try {
        const res = await fetch('/api/status');
        const latency = Date.now() - start;
        const data = await res.json();

        // Update UI Widget
        if (data.database && data.database.status === 'connected') {
          document.getElementById('adminDbDot').className = 'w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse';
          document.getElementById('adminDbStatusText').textContent = 'Connected';
          document.getElementById('adminDbNameText').textContent = `MySQL: ${data.database.name || 'db_lim_library'}`;
        } else {
          document.getElementById('adminDbDot').className = 'w-2.5 h-2.5 rounded-full bg-rose-500';
          document.getElementById('adminDbStatusText').textContent = 'Disconnected';
        }

        document.getElementById('adminServerUptime').textContent = data.uptime || '0m';
        document.getElementById('adminTimestampText').textContent = data.timestamp || new Date().toLocaleString();

        // Update Raw JSON Viewer
        const rawPre = document.getElementById('rawStatusJsonContent');
        if (rawPre) rawPre.textContent = JSON.stringify(data, null, 2);
        const latSpan = document.getElementById('rawStatusLatency');
        if (latSpan) latSpan.textContent = `${latency} ms`;

      } catch (err) {
        console.error('Error saat fetch /api/status:', err);
      } finally {
        if (refreshIcon) {
          setTimeout(() => refreshIcon.classList.remove('fa-spin'), 400);
        }
      }
    }

    function toggleRawStatusJson() {
      const container = document.getElementById('rawStatusJsonContainer');
      const label = document.getElementById('btnToggleJsonLabel');
      if (!container) return;

      if (container.classList.contains('hidden')) {
        container.classList.remove('hidden');
        if (label) label.textContent = 'Sembunyikan Raw JSON Response';
      } else {
        container.classList.add('hidden');
        if (label) label.textContent = 'Lihat Raw JSON Response';
      }
    }

    // ========================================================================
    // GET /api/produk - Ambil Seluruh Data Produk dari Database MySQL
    // ========================================================================
    async function loadAdminProductsData() {
      try {
        const res = await fetch('/api/produk');
        adminBooksData = await res.json();
        renderAdminTable(adminBooksData);
        updateAdminStatsCounters();
      } catch (err) {
        console.error('Gagal mengambil /api/produk:', err);
      }
    }

    function renderAdminTable(list) {
      const tbody = document.getElementById('adminTableBody');
      const countPill = document.getElementById('adminTableCountPill');
      const footerCount = document.getElementById('adminTableFooterCount');

      if (countPill) countPill.textContent = `${list.length} produk`;
      if (footerCount) footerCount.textContent = list.length;

      if (!tbody) return;

      if (list.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="8" class="text-center py-10 text-slate-400 text-xs">
              Tidak ada produk yang sesuai dengan kriteria filter atau pencarian.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = list.map(b => {
        const isAvail = b.status === 'Tersedia';
        const safeTitle = (b.nama || b.title || '').replace(/'/g, "\\'");

        return `
          <tr class="hover:bg-slate-50/70 transition-colors admin-row" id="row-${b.id}">
            <td class="px-5 py-3.5 font-mono whitespace-nowrap w-44 min-w-[150px]">
              <span class="inline-flex items-center px-3 py-1.5 rounded-xl bg-slate-100/90 text-slate-900 font-bold text-xs tracking-wider border border-slate-200/90 shadow-xs">
                <i class="fa-solid fa-barcode text-[11px] text-slate-400 mr-2"></i>
                ${b.kode || 'BOK-' + b.id}
              </span>
            </td>
            <td class="px-4 py-3.5 max-w-xs">
              <div class="font-bold text-slate-900 truncate" title="${b.nama || b.title}">
                ${b.nama || b.title}
              </div>
              <div class="text-[11px] text-slate-400 truncate">
                ${b.penulis || b.author} (${b.tahun || 2024})
              </div>
            </td>
            <td class="px-4 py-3.5">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-700 border border-slate-200">
                ${b.kategori || b.category || 'Umum'}
              </span>
            </td>
            <td class="px-4 py-3.5">
              ${isAvail 
                ? `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                     <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></span>
                     Tersedia
                   </span>`
                : `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-500 border border-slate-200">
                     <span class="w-1.5 h-1.5 rounded-full bg-slate-400 mr-1.5"></span>
                     Dipinjam
                   </span>`
              }
            </td>
            <td class="px-4 py-3.5 font-mono text-[11px] text-slate-500">
              ${b.lokasi_rak || b.lokasiRak || 'Rak Umum'}
            </td>
            <td class="px-4 py-3.5 text-center font-mono text-slate-700">
              ${b.tahun || 2024}
            </td>
            <td class="px-4 py-3.5 text-right whitespace-nowrap">
              <div class="inline-flex items-center space-x-1.5">
                <button 
                  onclick="openDetailAdmin('${b.id}')" 
                  title="GET /api/produk/${b.id}"
                  class="p-1.5 rounded-lg text-slate-500 hover:text-blue-600 hover:bg-blue-50 border border-slate-200 transition-colors"
                >
                  <i class="fa-regular fa-eye text-xs"></i>
                </button>
                <button 
                  onclick="openEditAdmin('${b.id}')" 
                  title="PUT /api/produk/${b.id}"
                  class="p-1.5 rounded-lg text-slate-500 hover:text-amber-600 hover:bg-amber-50 border border-slate-200 transition-colors"
                >
                  <i class="fa-regular fa-pen-to-square text-xs"></i>
                </button>
                <button 
                  onclick="openDeleteAdmin('${b.id}', '${safeTitle}')" 
                  title="DELETE /api/produk/${b.id}"
                  class="p-1.5 rounded-lg text-slate-500 hover:text-rose-600 hover:bg-rose-50 border border-slate-200 transition-colors"
                >
                  <i class="fa-regular fa-trash-can text-xs"></i>
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

    function setupAdminSearch() {
      const search = document.getElementById('adminSearchInput');
      if (!search) return;
      search.addEventListener('input', () => filterAdminTable());
    }

    function filterAdminTable() {
      const query = (document.getElementById('adminSearchInput')?.value || '').toLowerCase().trim();
      const cat = document.getElementById('adminFilterCategory')?.value || 'Semua';
      const status = document.getElementById('adminFilterStatus')?.value || 'Semua';

      const filtered = adminBooksData.filter(b => {
        const title = (b.nama || b.title || '').toLowerCase();
        const author = (b.penulis || b.author || '').toLowerCase();
        const code = (b.kode || '').toLowerCase();
        const shelf = (b.lokasi_rak || b.lokasiRak || '').toLowerCase();
        const bCat = b.kategori || b.category || 'Umum';
        const bStatus = b.status || 'Tersedia';

        const matchQuery = !query || title.includes(query) || author.includes(query) || code.includes(query) || shelf.includes(query);
        const matchCat = cat === 'Semua' || bCat === cat;
        const matchStatus = status === 'Semua' || bStatus === status;

        return matchQuery && matchCat && matchStatus;
      });

      renderAdminTable(filtered);
    }

    function updateAdminStatsCounters() {
      const total = adminBooksData.length;
      const avail = adminBooksData.filter(b => b.status === 'Tersedia').length;
      const borrowed = total - avail;

      const totalSpan = document.getElementById('adminTotalBooksCount');
      const availSpan = document.getElementById('adminAvailCount');
      const borrowSpan = document.getElementById('adminBorrowCount');

      if (totalSpan) totalSpan.textContent = total;
      if (availSpan) availSpan.textContent = `${avail} Tersedia`;
      if (borrowSpan) borrowSpan.textContent = `${borrowed} Dipinjam`;
    }

    // ========================================================================
    // GET /api/produk/:id - Baca Detail Satu Produk & Raw JSON
    // ========================================================================
    async function openDetailAdmin(id) {
      try {
        const res = await fetch(`/api/produk/${id}`);
        const result = await res.json();
        const book = result.data || result;

        if (!res.ok || !book) {
          alert('Produk tidak ditemukan di database.');
          return;
        }

        document.getElementById('detailEndpointLabel').textContent = `GET /api/produk/${id}`;
        document.getElementById('detailCategory').textContent = book.kategori || book.category || 'Umum';
        document.getElementById('detailTitle').textContent = book.nama || book.title || '-';
        document.getElementById('detailAuthor').textContent = `Penulis: ${book.penulis || book.author || '-'} (${book.tahun || 2024})`;
        document.getElementById('detailCode').textContent = book.kode || `BOK-${book.id}`;
        document.getElementById('detailShelf').textContent = book.lokasi_rak || book.lokasiRak || 'Rak Umum';
        document.getElementById('detailYear').textContent = book.tahun || 2024;
        document.getElementById('detailDesc').textContent = book.deskripsi || book.description || 'Tidak ada deskripsi.';

        const isAvail = book.status === 'Tersedia';
        const badge = document.getElementById('detailStatusBadge');
        if (isAvail) {
          badge.className = 'px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200';
          badge.textContent = 'Tersedia';
        } else {
          badge.className = 'px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-100 text-slate-500 border border-slate-200';
          badge.textContent = 'Dipinjam';
        }

        document.getElementById('detailJsonPre').textContent = JSON.stringify(result, null, 2);

        document.getElementById('modalDetailAdmin').classList.remove('hidden');
      } catch (err) {
        alert('Gagal mengambil detail produk: ' + err.message);
      }
    }

    function closeDetailAdmin() {
      document.getElementById('modalDetailAdmin').classList.add('hidden');
    }

    // ========================================================================
    // POST /api/produk - Tambah Produk Baru ke Database MySQL
    // ========================================================================
    function openAddModalAdmin() {
      document.getElementById('modalAddAdmin').classList.remove('hidden');
    }

    function closeAddAdmin() {
      document.getElementById('modalAddAdmin').classList.add('hidden');
      document.getElementById('formAddAdmin')?.reset();
    }

    async function handleCreateAdmin(e) {
      e.preventDefault();
      const form = e.target;
      const btn = document.getElementById('btnSubmitAddAdmin');

      const payload = {
        nama: form.nama.value.trim(),
        penulis: form.penulis.value.trim(),
        kategori_id: Number(form.kategori_id.value),
        tahun: Number(form.tahun.value || 2025),
        lokasi_rak: form.lokasi_rak.value.trim(),
        deskripsi: form.deskripsi.value.trim()
      };

      try {
        if (btn) {
          btn.disabled = true;
          btn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> Menyimpan...`;
        }

        const res = await fetch('/api/produk', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();

        if (res.ok) {
          showAdminToast('POST 201 Created', 'Buku baru berhasil tersimpan ke database MySQL!');
          closeAddAdmin();
          await loadAdminProductsData();
          fetchLiveSystemStatus();
        } else {
          alert('Gagal: ' + (data.message || 'Terjadi kesalahan saat menambahkan buku.'));
        }
      } catch (err) {
        alert('Error: ' + err.message);
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = `<i class="fa-solid fa-cloud-arrow-up"></i><span>Simpan ke Database (POST)</span>`;
        }
      }
    }

    // ========================================================================
    // PUT /api/produk/:id - Perbarui Data Produk di Database MySQL
    // ========================================================================
    async function openEditAdmin(id) {
      try {
        const res = await fetch(`/api/produk/${id}`);
        const result = await res.json();
        const book = result.data || result;

        if (!book) {
          alert('Produk tidak ditemukan.');
          return;
        }

        document.getElementById('editEndpointLabel').textContent = `PUT /api/produk/${id}`;
        document.getElementById('editAdminId').value = book.id;
        document.getElementById('editAdminNama').value = book.nama || book.title || '';
        document.getElementById('editAdminPenulis').value = book.penulis || book.author || '';
        document.getElementById('editAdminKategoriId').value = book.kategori_id || '1';
        document.getElementById('editAdminStatus').value = book.status || 'Tersedia';
        document.getElementById('editAdminLokasiRak').value = book.lokasi_rak || book.lokasiRak || 'Rak Umum';
        document.getElementById('editAdminTahun').value = book.tahun || 2024;
        document.getElementById('editAdminDeskripsi').value = book.deskripsi || book.description || '';

        document.getElementById('modalEditAdmin').classList.remove('hidden');
      } catch (err) {
        alert('Gagal memuat data buku: ' + err.message);
      }
    }

    function closeEditAdmin() {
      document.getElementById('modalEditAdmin').classList.add('hidden');
    }

    async function handleUpdateAdmin(e) {
      e.preventDefault();
      const form = e.target;
      const id = document.getElementById('editAdminId').value;
      const btn = document.getElementById('btnSubmitEditAdmin');

      const payload = {
        nama: form.nama.value.trim(),
        penulis: form.penulis.value.trim(),
        kategori_id: Number(form.kategori_id.value),
        status: form.status.value,
        lokasi_rak: form.lokasi_rak.value.trim(),
        tahun: Number(form.tahun.value || 2024),
        deskripsi: form.deskripsi.value.trim()
      };

      try {
        if (btn) {
          btn.disabled = true;
          btn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> Menyimpan...`;
        }

        const res = await fetch(`/api/produk/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();

        if (res.ok) {
          showAdminToast('PUT 200 OK', 'Data produk berhasil diperbarui di database MySQL!');
          closeEditAdmin();
          await loadAdminProductsData();
        } else {
          alert('Gagal memperbarui: ' + (data.message || 'Terjadi kesalahan'));
        }
      } catch (err) {
        alert('Error: ' + err.message);
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = `<i class="fa-solid fa-check"></i><span>Simpan Perubahan (PUT)</span>`;
        }
      }
    }

    // ========================================================================
    // DELETE /api/produk/:id - Hapus Produk dari Database MySQL
    // ========================================================================
    function openDeleteAdmin(id, title) {
      pendingDeleteAdminId = id;
      document.getElementById('deleteEndpointLabel').textContent = `DELETE /api/produk/${id}`;
      document.getElementById('deleteAdminBookTitle').textContent = `"${title}" (#${id})`;
      document.getElementById('modalDeleteAdmin').classList.remove('hidden');
    }

    function closeDeleteAdmin() {
      pendingDeleteAdminId = null;
      document.getElementById('modalDeleteAdmin').classList.add('hidden');
    }

    async function confirmDeleteAdmin() {
      if (!pendingDeleteAdminId) return;
      const btn = document.getElementById('btnConfirmDeleteAdmin');

      try {
        if (btn) {
          btn.disabled = true;
          btn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> Menghapus...`;
        }

        const res = await fetch(`/api/produk/${pendingDeleteAdminId}`, {
          method: 'DELETE'
        });

        const data = await res.json();

        if (res.ok) {
          showAdminToast('DELETE 200 OK', 'Produk berhasil dihapus dari database MySQL!');
          closeDeleteAdmin();
          await loadAdminProductsData();
          fetchLiveSystemStatus();
        } else {
          alert('Gagal menghapus: ' + (data.message || 'Terjadi kesalahan'));
        }
      } catch (err) {
        alert('Error: ' + err.message);
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Ya, Hapus Sekarang';
        }
      }
    }

    // ========================================================================
    // Toast Notifikasi
    // ========================================================================
    function showAdminToast(title, message) {
      const toast = document.getElementById('toastNotificationAdmin');
      const tTitle = document.getElementById('toastTitleAdmin');
      const tMsg = document.getElementById('toastMessageAdmin');
      if (!toast) return;

      if (tTitle) tTitle.textContent = title;
      if (tMsg) tMsg.textContent = message;

      toast.classList.remove('hidden');
      setTimeout(() => {
        toast.classList.add('hidden');
      }, 4000);
    }
  </script>

  <!-- Modal API Console Tester (Kompatibilitas) -->
  <%- include('partials/apiModal') %>

</body>
</html>
