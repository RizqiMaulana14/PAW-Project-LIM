<!-- Floating AI Chatbot Widget (Pustaka AI - Ollama DeepSeek-v2) -->
<div id="aiChatbotWidget" class="fixed bottom-6 right-6 z-50 w-96 max-w-[calc(100vw-2rem)] bg-white border border-slate-200/90 rounded-3xl shadow-2xl flex flex-col overflow-hidden transition-all duration-300 hidden">
  
  <!-- Chatbot Header -->
  <div class="bg-slate-900 text-white p-4 flex items-center justify-between">
    <div class="flex items-center space-x-2.5">
      <div class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></div>
      <div>
        <h4 class="text-xs font-bold leading-none">Pustaka AI</h4>
        <p class="text-[10px] text-slate-400 mt-1">Online • Ollama DeepSeek-v2</p>
      </div>
    </div>
    <button onclick="toggleAiChatbot()" class="text-slate-400 hover:text-white text-sm p-1">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>

  <!-- Chat Messages Container -->
  <div id="chatMessages" class="p-4 space-y-3 h-80 overflow-y-auto text-xs bg-slate-50/70">
    <!-- Greeting Bubble -->
    <div class="flex items-start space-x-2">
      <div class="w-6 h-6 rounded-full bg-slate-900 text-white flex items-center justify-center text-[10px] shrink-0 mt-0.5">
        <i class="fa-solid fa-robot"></i>
      </div>
      <div class="bg-white p-3 rounded-2xl rounded-tl-sm border border-slate-200 shadow-sm text-slate-700 leading-relaxed max-w-[85%]">
        Halo, Naya! Mau cari rekomendasi buku, tanya sinopsis, atau cek ketersediaan buku di perpustakaan?
      </div>
    </div>

    <!-- Example Preloaded Chat from Mockup -->
    <div class="flex items-start justify-end space-x-2">
      <div class="bg-slate-900 text-white p-3 rounded-2xl rounded-tr-sm shadow-sm leading-relaxed max-w-[85%]">
        Sinopsis Laut Bercerita
      </div>
    </div>

    <div class="flex items-start space-x-2">
      <div class="w-6 h-6 rounded-full bg-slate-900 text-white flex items-center justify-center text-[10px] shrink-0 mt-0.5">
        <i class="fa-solid fa-robot"></i>
      </div>
      <div class="bg-white p-3 rounded-2xl rounded-tl-sm border border-slate-200 shadow-sm text-slate-700 leading-relaxed max-w-[85%]">
        <strong>Ringkasan:</strong> Kisah aktivis mahasiswa era 1998 yang diculik dan keluarga yang mencari kepastian jawaban atas kehilangan mereka. Ditulis oleh Leila S. Chudori.
      </div>
    </div>
  </div>

  <!-- Quick Prompts Chips -->
  <div class="px-4 py-2 bg-white border-t border-slate-100 flex items-center gap-1.5 overflow-x-auto text-[11px] scrollbar-none">
    <button onclick="sendQuickPrompt('Rekomendasi buku teknologi')" class="px-2.5 py-1 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 whitespace-nowrap transition-colors">
      Rekomendasi teknologi
    </button>
    <button onclick="sendQuickPrompt('Sinopsis Atomic Habits')" class="px-2.5 py-1 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 whitespace-nowrap transition-colors">
      Sinopsis Atomic Habits
    </button>
    <button onclick="sendQuickPrompt('Bagaimana cara pinjam buku?')" class="px-2.5 py-1 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 whitespace-nowrap transition-colors">
      Cara pinjam
    </button>
  </div>

  <!-- Chat Input Form -->
  <div class="p-3 bg-white border-t border-slate-200">
    <form id="aiChatForm" onsubmit="handleSendAiMessage(event)" class="flex items-center gap-2">
      <input 
        type="text" 
        id="aiChatInput" 
        placeholder="Tulis pertanyaanmu..." 
        class="flex-grow px-3 py-2 bg-slate-100 border border-slate-200 rounded-xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-slate-900 transition-all"
      >
      <button 
        type="submit" 
        class="w-8 h-8 rounded-xl bg-slate-900 hover:bg-slate-800 text-white flex items-center justify-center text-xs shadow-sm transition-all shrink-0"
      >
        <i class="fa-solid fa-arrow-up"></i>
      </button>
    </form>
    <div class="mt-2 text-center">
      <button onclick="toggleAiChatbot()" class="text-[11px] text-slate-400 hover:text-slate-600 transition-colors">
        Tutup chat
      </button>
    </div>
  </div>

</div>
