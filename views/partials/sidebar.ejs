<!-- Sidebar Navigasi Pustaka (Persistent Layout) -->
<aside class="w-full md:w-64 bg-white border-r border-slate-200/90 flex flex-col justify-between p-5 md:min-h-screen shrink-0">
  
  <div class="space-y-6">
    <!-- Brand Header -->
    <a href="/" class="flex items-center space-x-3 group">
      <div class="w-10 h-10 rounded-xl bg-slate-200 flex items-center justify-center text-slate-700 font-bold group-hover:bg-slate-900 group-hover:text-white transition-all shadow-sm">
        <i class="fa-solid fa-book-bookmark text-base"></i>
      </div>
      <div>
        <h2 class="font-extrabold text-base tracking-tight text-slate-900 font-heading">Pustaka</h2>
        <p class="text-[11px] text-slate-400 font-medium">Ruang baca digital • LIM</p>
      </div>
    </a>

    <!-- Nav Menu List -->
    <nav class="space-y-1.5 text-sm font-medium">
      <a 
        href="/katalog" 
        class="flex items-center justify-between px-3.5 py-2.5 rounded-xl transition-colors <%= currentRoute === 'katalog' ? 'bg-slate-100 text-slate-900 font-semibold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50' %>"
      >
        <div class="flex items-center space-x-3">
          <i class="fa-regular fa-compass w-4 text-center"></i>
          <span>Katalog</span>
        </div>
      </a>

      <a 
        href="/log-peminjaman" 
        class="flex items-center justify-between px-3.5 py-2.5 rounded-xl transition-colors <%= currentRoute === 'log' ? 'bg-slate-100 text-slate-900 font-semibold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50' %>"
      >
        <div class="flex items-center space-x-3">
          <i class="fa-regular fa-calendar-check w-4 text-center"></i>
          <span>Log Peminjaman</span>
        </div>
        <span class="w-5 h-5 rounded-full bg-slate-900 text-white text-[11px] font-bold flex items-center justify-center font-mono" id="sidebarActiveLoanBadge">
          <%= typeof loanStats !== 'undefined' ? loanStats.activeCount : 2 %>
        </span>
      </a>

      <a 
        href="/jadwal" 
        class="flex items-center justify-between px-3.5 py-2.5 rounded-xl transition-colors <%= currentRoute === 'jadwal' ? 'bg-slate-100 text-slate-900 font-semibold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50' %>"
      >
        <div class="flex items-center space-x-3">
          <i class="fa-regular fa-calendar-days w-4 text-center"></i>
          <span>Jadwal & Pinjam</span>
        </div>
      </a>

      <!-- Menu Area Admin (CRUD & Status Server) -->
      <div class="pt-4 pb-1">
        <span class="text-[10px] font-bold tracking-wider text-slate-400 uppercase px-3.5">Administrasi</span>
      </div>

      <a 
        href="/admin" 
        class="flex items-center justify-between px-3.5 py-2.5 rounded-xl transition-all <%= currentRoute === 'admin' ? 'bg-slate-900 text-white font-semibold shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50' %>"
      >
        <div class="flex items-center space-x-3">
          <i class="fa-solid fa-gauge-high w-4 text-center <%= currentRoute === 'admin' ? 'text-amber-400' : 'text-slate-500' %>"></i>
          <span>Panel Admin</span>
        </div>
        <span class="text-[10px] px-1.5 py-0.5 rounded font-mono font-bold <%= currentRoute === 'admin' ? 'bg-slate-800 text-amber-300' : 'bg-slate-100 text-slate-600' %>">Admin</span>
      </a>
    </nav>
  </div>

  <!-- Bottom User Profile -->
  <div class="space-y-4 pt-6 border-t border-slate-100">
    <!-- User Profile Bar (Dinamis: Mahasiswa atau Admin) -->
    <div class="flex items-center justify-between pt-2">
      <div class="flex items-center space-x-3">
        <div class="w-9 h-9 rounded-full <%= currentRoute === 'admin' ? 'bg-amber-100 text-amber-900 border border-amber-300' : 'bg-slate-300 text-slate-700' %> flex items-center justify-center font-bold text-xs uppercase">
          <%= currentRoute === 'admin' ? 'AD' : 'NA' %>
        </div>
        <div class="leading-tight">
          <h5 class="text-xs font-bold text-slate-900"><%= currentRoute === 'admin' ? 'Admin Pustaka' : 'Naya Aulia' %></h5>
          <p class="text-[11px] text-slate-400"><%= currentRoute === 'admin' ? 'Pustakawan (Superuser)' : 'Mahasiswa' %></p>
        </div>
      </div>
      <% if (currentRoute === 'admin') { %>
        <a href="/katalog" title="Beralih ke tampilan Mahasiswa" class="text-slate-400 hover:text-slate-700 text-xs px-2 py-1 rounded-lg border border-slate-200 hover:bg-slate-50">
          <i class="fa-solid fa-arrow-right-from-bracket"></i>
        </a>
      <% } else { %>
        <a href="/admin" title="Beralih ke panel Admin" class="text-slate-400 hover:text-slate-700 text-xs px-2 py-1 rounded-lg border border-slate-200 hover:bg-slate-50">
          <i class="fa-solid fa-user-shield"></i>
        </a>
      <% } %>
    </div>
  </div>

</aside>
