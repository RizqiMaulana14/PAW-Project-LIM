<!-- Modal REST API Tester CRUD & Database (PPAW Project Berkelanjutan) -->
<div id="apiTesterModal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
  <div class="bg-white border border-slate-200 rounded-3xl max-w-3xl w-full p-6 space-y-4 shadow-2xl relative">
    
    <!-- Modal Header -->
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <div class="flex items-center space-x-3">
        <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 border border-blue-100 flex items-center justify-center font-bold text-sm">
          <i class="fa-solid fa-terminal"></i>
        </div>
        <div>
          <h3 class="text-base font-bold text-slate-900 font-heading">REST API Console & CRUD Tester</h3>
          <p class="text-xs text-slate-400">Pengujian Terintegrasi Database MySQL — Kelompok 2 PAW</p>
        </div>
      </div>
      <button onclick="closeApiTesterModal()" class="text-slate-400 hover:text-slate-700 text-lg p-1">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Endpoint Trigger Buttons Bar -->
    <div class="flex flex-wrap items-center gap-2">
      <!-- GET Status -->
      <button 
        onclick="testApiEndpoint('/api/status', 'GET')" 
        class="px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-all flex items-center space-x-1.5"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span>GET Status</span>
      </button>

      <!-- GET /api/produk -->
      <button 
        onclick="testApiEndpoint('/api/produk', 'GET')" 
        class="px-3 py-1.5 rounded-xl text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 transition-all flex items-center space-x-1.5"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
        <span>GET /api/produk</span>
      </button>

      <!-- GET /api/produk/1 -->
      <button 
        onclick="testApiEndpoint('/api/produk/1', 'GET')" 
        class="px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-all"
      >
        <span>GET Detail (ID 1)</span>
      </button>

      <!-- POST /api/produk -->
      <button 
        onclick="testApiCreateProduct()" 
        class="px-3 py-1.5 rounded-xl text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-500 transition-all flex items-center space-x-1"
      >
        <i class="fa-solid fa-plus text-[10px]"></i>
        <span>POST Create</span>
      </button>

      <!-- PUT /api/produk/1 -->
      <button 
        onclick="testApiUpdateProduct()" 
        class="px-3 py-1.5 rounded-xl text-xs font-semibold text-white bg-amber-600 hover:bg-amber-500 transition-all flex items-center space-x-1"
      >
        <i class="fa-solid fa-pen text-[10px]"></i>
        <span>PUT Update (ID 1)</span>
      </button>

      <!-- DELETE /api/produk/latest -->
      <button 
        onclick="testApiDeleteLatest()" 
        class="px-3 py-1.5 rounded-xl text-xs font-semibold text-white bg-rose-600 hover:bg-rose-500 transition-all flex items-center space-x-1"
      >
        <i class="fa-solid fa-trash text-[10px]"></i>
        <span>DELETE Test Item</span>
      </button>

      <a 
        href="/api/produk" 
        target="_blank" 
        class="px-3 py-1.5 rounded-xl text-xs text-slate-500 hover:text-slate-800 border border-slate-200 hover:bg-slate-50 transition-colors ml-auto"
      >
        <i class="fa-solid fa-arrow-up-right-from-square mr-1"></i> Buka JSON
      </a>
    </div>

    <!-- Output Box -->
    <div class="bg-slate-900 rounded-2xl p-4 text-xs font-mono text-slate-200 space-y-2">
      <div class="flex items-center justify-between text-[11px] text-slate-400 pb-2 border-b border-slate-800">
        <span id="apiModalStatus">Status: Siap Menguji CRUD</span>
        <span id="apiModalLatency">0 ms</span>
      </div>
      <pre id="apiModalJson" class="h-64 overflow-y-auto text-blue-300 leading-relaxed whitespace-pre-wrap break-all text-[11px]">Klik salah satu tombol endpoint di atas untuk menguji response GET, POST, PUT, atau DELETE secara langsung.</pre>
    </div>

    <!-- Logger Notice -->
    <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 text-[11px] text-slate-600 flex items-start space-x-2">
      <i class="fa-solid fa-circle-info text-blue-500 mt-0.5"></i>
      <span>
        Seluruh request CRUD di atas otomatis dieksekusi ke <strong>database MySQL</strong> dan dicatat oleh <code>middlewares/logger.js</code> di terminal backend dengan HTTP Method, Status Code, dan Timestamp!
      </span>
    </div>

  </div>
</div>
